# Only build inputs enter the builder: no website, deployments or credentials.
*
!rust-toolchain.toml
!crates/
crates/*
!crates/Cargo.toml
!crates/Cargo.lock
!crates/protocol/
crates/protocol/*
!crates/protocol/Cargo.toml
!crates/protocol/src/
!crates/models/
crates/models/*
!crates/models/Cargo.toml
!crates/models/src/
!server/
server/*
!server/Cargo.toml
!server/Cargo.lock
!server/src/
!server/migrations/
!server/LICENSE
**/target
**/.env*
**/.dev-mail
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.db
**/*.sqlite*
**/AGENTS.md
