# Reference only. init-config.py writes the real file outside the repository.
# Use single quotes for literal values containing $, #, spaces or double quotes.
# Do not source this file in a shell or print resolved docker compose config.
CC_DOMAIN=sync.example.org
CC_HTTP_PORT=8080
CC_POSTGRES_ADMIN_PASSWORD=
CC_DATABASE_PASSWORD=
# Server release; upgrade by changing it (image ghcr.io/evsikovas/consolecrypt-server:<version>).
CC_SERVER_VERSION=0.2.2
# Optional: the exact image instead, e.g. the digest from the release receipts.
#CC_SERVER_IMAGE=ghcr.io/evsikovas/consolecrypt-server@sha256:<digest>
CC_RUN_MIGRATIONS=true
CC_REGISTRATION_OPEN=true
CC_MAIL_TRANSPORT=smtp
CC_MAIL_FROM='ConsoleCrypt <no-reply@example.org>'
CC_SMTP_HOST=smtp.example.org
CC_SMTP_PORT=587
CC_SMTP_TLS=starttls
CC_SMTP_USERNAME=mailer@example.org
CC_SMTP_PASSWORD=
CC_OBJECT_SHARING_ENABLED=false
CC_SHARED_GROUPS_ENABLED=false
CC_SHARED_SECRETS_ENABLED=false
CC_SHARED_KUBE_CONTEXTS_ENABLED=false
CC_SHARED_DB_CONNECTIONS_ENABLED=false
CC_SHARED_NOTES_ENABLED=false
CC_SHARING_OWNER_ONLINE_ENROLLMENT_ENABLED=false
CC_DEVICE_PROTECTION_ENABLED=false
#CC_TEAMS_ENABLED=true
# Server 0.2.2+: request limits observe | enforce, quotas (defaults shown).
#CC_RATE_LIMIT_MODE=observe
#CC_QUOTAS_V2_ENABLED=true
#CC_MAX_DEVICES_PER_ACCOUNT=20
#CC_MAX_VAULT_OBJECTS=100000
