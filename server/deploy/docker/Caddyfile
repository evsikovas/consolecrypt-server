{$CC_DOMAIN} {
	# No rewrite/handle_path: device proofs sign the exact request target/body.
	# reverse_proxy handles WebSocket upgrades and replaces untrusted XFF.
	# /account is the server's own account page when CC_WEB_ACCOUNT=true;
	# otherwise the server answers 404 there itself.
	@api path /v1 /v1/* /healthz /readyz /account /account/*
	handle @api {
		reverse_proxy server:8080
	}
	handle {
		respond "Not found" 404
	}
}
