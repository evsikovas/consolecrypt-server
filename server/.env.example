# ConsoleCrypt server configuration. Copy to `.env` (git-ignored) and adjust.
# Every variable is optional unless marked REQUIRED.

# --- docker-compose only -----------------------------------------------------
# REQUIRED for docker-compose: password of the bundled PostgreSQL. Generate one:
#   openssl rand -base64 32
CC_POSTGRES_PASSWORD=change-me
# Host ports.
CC_HTTP_PORT=8080
CC_METRICS_PORT=9090

# --- server ------------------------------------------------------------------
# REQUIRED outside docker-compose (compose sets it from CC_POSTGRES_PASSWORD).
# CC_DATABASE_URL=postgres://consolecrypt:PASSWORD@localhost:5432/consolecrypt
# Optional: password applied on top of the URL (no URL escaping needed).
# CC_DATABASE_PASSWORD=
CC_DATABASE_MAX_CONNECTIONS=20
# Startup keeps retrying an unreachable database this long before exiting.
CC_DATABASE_CONNECT_TIMEOUT_SECS=60
CC_RUN_MIGRATIONS=true
CC_LISTEN_ADDR=0.0.0.0:8080
# Prometheus metrics on a separate port; "off" disables.
CC_METRICS_LISTEN=0.0.0.0:9090
# json | pretty. Filter with CC_LOG (e.g. "info", "debug,sqlx=warn").
CC_LOG_FORMAT=json
# CC_LOG=info

# Public base URL (used in emails only).
# CC_PUBLIC_URL=https://sync.example.org
# AGPL-3.0 §13: where users can get the exact source this instance runs.
# Operators of MODIFIED builds must point this at their modified source.
# CC_SOURCE_CODE_URL=https://github.com/evsikovas/consolecrypt-server

CC_REGISTRATION_OPEN=true
CC_REQUIRE_EMAIL_VERIFICATION=false

# Token lifetimes (seconds).
CC_ACCESS_TOKEN_TTL_SECS=900
CC_REFRESH_TOKEN_TTL_SECS=2592000
CC_DEVICE_REQUEST_TTL_SECS=86400
CC_PASSWORD_RESET_TTL_SECS=3600
CC_EMAIL_VERIFY_TTL_SECS=172800

# Protocol 1.5 per-request device proofs (x-cc-device-proof): required by
# default, so a stolen access/refresh token is useless without the device key.
# `false` is an explicit, warned opt-out ONLY for migrating clients that do not
# sign yet (invalid proofs are still rejected; missing ones are counted in
# cc_request_proofs_total{result="missing"}).
CC_REQUIRE_REQUEST_PROOF=true

# Set to true ONLY when exactly one trusted reverse proxy (ingress) sits in
# front and appends X-Forwarded-For.
CC_TRUST_PROXY_HEADERS=false
# postgres (works with several replicas) | local (single instance)
CC_EVENT_BUS=postgres
CC_HSTS=true

# Account password hashing (Argon2id). Defaults follow OWASP guidance.
CC_ARGON2_MEMORY_KIB=19456
CC_ARGON2_ITERATIONS=2
CC_ARGON2_PARALLELISM=1
# Concurrent hashes (each holds CC_ARGON2_MEMORY_KIB of RAM). Default: CPUs, max 4.
# CC_ARGON2_MAX_CONCURRENT=4

# Rate limits (per server replica).
CC_RATE_LIMIT_ENABLED=true
CC_RATE_LIMIT_AUTH_PER_IP_PER_MINUTE=30
CC_RATE_LIMIT_LOGIN_PER_EMAIL_PER_MINUTE=10
CC_RATE_LIMIT_RECOVERY_PER_EMAIL_PER_HOUR=5
CC_RATE_LIMIT_PROOF_PER_DEVICE_PER_MINUTE=20

# Mail: disabled | file | smtp.
#  - disabled: nothing is sent; use `consolecrypt-server admin reset-token --email …`
#  - file: development; messages are written to CC_MAIL_DIR (never logged)
CC_MAIL_TRANSPORT=file
CC_MAIL_DIR=./.dev-mail
CC_MAIL_FROM=ConsoleCrypt <no-reply@localhost>
# CC_SMTP_HOST=smtp.example.org
# CC_SMTP_PORT=587
# tls (465) | starttls (587) | none (local relay only)
# CC_SMTP_TLS=starttls
# CC_SMTP_USERNAME=
# CC_SMTP_PASSWORD=

# Sync page byte budget and WebSocket timings.
CC_SYNC_PAGE_BYTES=8388608
# Quotas: live ciphertext per vault (push beyond → 413, details.reason =
# vault_quota) and vaults per account (→ 403, details.reason = vault_limit).
CC_MAX_VAULT_BYTES=1073741824
CC_MAX_VAULTS_PER_ACCOUNT=50
CC_WS_PING_INTERVAL_SECS=30
CC_WS_SESSION_RECHECK_SECS=30
# Concurrent WebSocket connections per account (per replica); more → 429.
CC_WS_MAX_CONNECTIONS_PER_USER=32

# Maintenance / retention (a pass runs every CC_MAINTENANCE_INTERVAL_SECS on
# one replica at a time; 0 disables). Retention in days; 0 keeps forever.
CC_MAINTENANCE_INTERVAL_SECS=3600
CC_RETENTION_SESSION_DAYS=7
CC_RETENTION_SYNC_MUTATION_DAYS=30
CC_RETENTION_AUDIT_DAYS=365
CC_RETENTION_DELETED_VAULT_DAYS=30
CC_RETENTION_DEVICE_REQUEST_DAYS=90

# OpenTelemetry traces (OTLP over HTTP/protobuf). Disabled unless an endpoint
# is set; standard OTEL_* variables apply. Spans carry only non-secret fields
# (request_id, route, status, user/device UUIDs).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Experimental object sharing (ADR-0008); requires signed request proofs.
CC_OBJECT_SHARING_ENABLED=false
# ADR-0009: independent kind gates; require general sharing and strict proofs.
CC_SHARED_GROUPS_ENABLED=false
CC_SHARED_SECRETS_ENABLED=false
CC_SHARED_KUBE_CONTEXTS_ENABLED=false
CC_SHARED_DB_CONNECTIONS_ENABLED=false
# ADR-0009 own-device enrollment; explicit isolated acceptance only.
CC_SHARING_OWNER_ONLINE_ENROLLMENT_ENABLED=false

# New-device protection (protocol 1.7; docs/public/HOSTING.md). Off by default.
# Needs the web account page (CC_PUBLIC_URL/account#action=deny-device) for the
# "This wasn't me" links in its mails.
CC_DEVICE_PROTECTION_ENABLED=false
# CC_NEW_DEVICE_MAIL_ENABLED=true
# CC_DEVICE_QUARANTINE_DAYS=14
# Vault unlock material for untrusted devices (shared by replicas; 0 = no limit).
# CC_ENVELOPE_LIMIT_ACCOUNT_PER_HOUR=5
# CC_ENVELOPE_LIMIT_ACCOUNT_PER_DAY=20
# CC_ENVELOPE_LIMIT_DEVICE_PER_HOUR=3
# CC_NEW_DEVICE_MAIL_PER_HOUR=10

# Sign-in mode (server 0.2.0, protocol 1.8; docs/public/ENTERPRISE.md).
# standard (default): email + account password. enterprise: only the IdP
# (OIDC) or Active Directory / LDAP; secrets are read from files.
# CC_AUTH_MODE=standard
# CC_AUTH_PROVIDER=oidc
# CC_AUTH_DISPLAY_NAME=Acme SSO
# CC_AUTH_ALLOWED_DOMAINS=acme.com
# CC_AUTH_AUTO_CREATE=true
# CC_AUTH_RECHECK_MINUTES=15
# CC_AUTH_RECHECK_GRACE_HOURS=24
# CC_OIDC_PRESET=entra
# CC_OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# CC_OIDC_CLIENT_ID=
# CC_OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc-client-secret
# CC_OIDC_TOKEN_KEY_FILE=/run/secrets/oidc-token-key
# CC_OIDC_REQUIRED_CLAIM=roles=ConsoleCrypt.User
# CC_LDAP_URL=ldaps://dc1.acme.local:636
# CC_LDAP_CA_FILE=/run/secrets/ad-ca.pem
# CC_LDAP_BIND_DN=CN=svc-consolecrypt,OU=Service,DC=acme,DC=local
# CC_LDAP_BIND_PASSWORD_FILE=/run/secrets/ldap-bind-password
# CC_LDAP_BASE_DN=DC=acme,DC=local
# CC_LDAP_REQUIRED_GROUP=CN=ConsoleCrypt,OU=Groups,DC=acme,DC=local
# Keep below the domain's account lockout threshold:
# CC_LDAP_MAX_FAILURES=3
# CC_LDAP_FAILURE_WINDOW_MINUTES=15
# Native binary: --config /etc/consolecrypt/server.json (or CC_CONFIG_FILE).
# Environment overrides the private JSON file. See deploy/native/README.md.
